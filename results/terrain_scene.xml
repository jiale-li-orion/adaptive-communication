
<scene version="3.0.0">
    <integrator type="path">
        <integer name="max_depth" value="4"/>
    </integrator>

    <shape type="obj">
        <string name="filename" value="terrain_mesh.obj"/>
        <bsdf type="diffuse">
            <rgb name="reflectance" value="0.35 0.32 0.28"/>
        </bsdf>
    </shape>

    <emitter type="constant">
        <rgb name="radiance" value="1.2 1.3 1.5"/>
