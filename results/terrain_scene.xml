            <lookat origin="-9000, -14000, 11000" target="0, 0, 0" up="0, 0, 1"/>
        </transform>
        <float name="fov" value="45"/>
        <float name="near_clip" value="1.0"/>
        <float name="far_clip" value="200000"/>
        <film type="hdrfilm">
            <integer name="width" value="800"/>
            <integer name="height" value="600"/>
            <rfilter type="box"/>
        </film>
    </sensor>
</scene>
