{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaptive-communication/research/benchmark/SERVICE-TRACE-PROFILE-SCHEMA.v0.1.json",
  "title": "Layer-1 Service Semantics Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "service_trace_profile_id",
    "provenance_class",
    "service_rule",
    "ack_rule",
    "failure_rule",
    "stress_rationale",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "service_trace_profile_id": {"type": "string"},
    "provenance_class": {"const": "CONTROLLED_STRESS"},
    "service_rule": {"type": "string"},
    "ack_rule": {"type": "string"},
    "failure_rule": {"type": "string"},
    "stress_rationale": {"type": "string", "minLength": 1},
    "claim_boundary": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
