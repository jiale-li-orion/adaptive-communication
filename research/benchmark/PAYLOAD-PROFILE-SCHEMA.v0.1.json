{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaptive-communication/research/benchmark/PAYLOAD-PROFILE-SCHEMA.v0.1.json",
  "title": "Layer-1 Source-derived Payload Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "payload_profile_id",
    "source_refs",
    "payload_class",
    "encoded_bytes",
    "derivation",
    "scope",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "payload_profile_id": {"type": "string", "minLength": 1},
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "source_class", "directness"],
        "properties": {
          "source_id": {"type": "string"},
          "source_class": {"type": "string"},
          "directness": {"enum": ["DIRECT_PARAMETER", "DIRECT_CAPABILITY"]},
          "snapshot_ref": {"type": ["string", "null"]},
          "locator": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "payload_class": {"type": "string"},
    "encoded_bytes": {"type": "integer", "minimum": 1},
    "derivation": {"type": "object"},
    "scope": {"type": "object"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
