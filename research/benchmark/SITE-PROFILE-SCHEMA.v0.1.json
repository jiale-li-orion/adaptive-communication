{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaptive-communication/research/benchmark/SITE-PROFILE-SCHEMA.v0.1.json",
  "title": "Layer-1 Site Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "site_profile_id",
    "source_refs",
    "jurisdiction",
    "site_identity",
    "coordinates",
    "variables",
    "scope",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "site_profile_id": {"type": "string"},
    "source_refs": {"type": "array", "minItems": 1},
    "jurisdiction": {"type": "string"},
    "site_identity": {"type": "object"},
    "coordinates": {
      "type": "object",
      "required": ["lat_deg", "lon_deg"],
      "properties": {
        "lat_deg": {"type": "number", "minimum": -90, "maximum": 90},
        "lon_deg": {"type": "number", "minimum": -180, "maximum": 180},
        "coordinate_source_ref_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "variables": {"type": "object"},
    "scope": {"type": "object"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
