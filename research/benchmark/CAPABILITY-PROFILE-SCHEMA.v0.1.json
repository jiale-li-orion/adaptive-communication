{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adaptive-communication/research/benchmark/CAPABILITY-PROFILE-SCHEMA.v0.1.json",
  "title": "Layer-1 Communication Capability Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capability_profile_id",
    "source_refs",
    "scope",
    "capabilities",
    "variables",
    "unknowns",
    "oracle_status"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "capability_profile_id": {"type": "string", "minLength": 1},
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "source_class", "directness"],
        "properties": {
          "source_id": {"type": "string"},
          "source_class": {"type": "string"},
          "directness": {
            "enum": ["DIRECT_CAPABILITY", "DIRECT_PARAMETER", "ADJACENT_MECHANISM"]
          },
          "snapshot_ref": {"type": ["string", "null"]},
          "locator": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "scope": {"type": "object"},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["capability_id", "owner", "constraints", "source_ref_ids"],
        "properties": {
          "capability_id": {"type": "string"},
          "owner": {"type": "string"},
          "constraints": {"type": "object"},
          "source_ref_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    },
    "variables": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["provenance_class", "answer_relevant", "source_ref_ids"],
        "properties": {
          "provenance_class": {
            "enum": [
              "FIXED_BY_SOURCE",
              "SOURCE_RANGE",
              "EMPIRICAL_TRACE",
              "MODEL_DERIVED_TRACE",
              "CONTROLLED_STRESS",
              "UNRESOLVED"
            ]
          },
          "answer_relevant": {"type": "boolean"},
          "source_ref_ids": {
            "type": "array",
            "items": {"type": "string"}
          },
          "value": {},
          "range": {},
          "unresolved_reason": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "answer_relevant", "reason"],
        "properties": {
          "field": {"type": "string"},
          "answer_relevant": {"type": "boolean"},
          "reason": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "oracle_status": {
      "enum": ["READY_FOR_COMPATIBILITY", "PARTIAL_SOURCE_GAP", "ADJACENT_ONLY"]
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
